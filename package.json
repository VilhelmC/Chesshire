{
	"name": "chesshire",
	"private": true,
	"license": "GPL-3.0-or-later",
	"version": "0.1.0",
	"type": "module",
	"description": "Offbook — a chess trainer that drills the seam between book moves and what your opponent actually plays",
	"scripts": {
		"postinstall": "node scripts/copy-engine.mjs",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"openings": "node scripts/build-openings.mjs",
		"icons": "node scripts/build-icons.mjs",
		"deploy": "node scripts/deploy-pages.mjs",
		"pwa:check": "npm run build && node scripts/pwa-check.mjs",
		"shots": "npm run build && node scripts/shots.mjs"
	},
	"dependencies": {
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"chessground": "^9.2.1",
		"chessops": "^0.15.1",
		"dexie": "^4.4.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"stockfish": "^18.0.8",
		"ts-fsrs": "^5.4.1"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"playwright": "^1.62.1",
		"typescript": "^5.7.2",
		"vite": "^5.4.11",
		"vitest": "^2.1.8"
	}
}
